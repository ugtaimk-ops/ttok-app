rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net - Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for auth state and ownership
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules for Users collection and subcollections
    match /users/{userId} {
      // isPremium/aiUsageCount/aiUsageMonth are server-managed (services/usageService.ts,
      // via the Admin SDK which bypasses these rules) - the client must never be able to
      // set them itself, or anyone could grant themselves premium for free.
      function touchesServerManagedFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isPremium', 'aiUsageCount', 'aiUsageMonth']);
      }

      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['isPremium', 'aiUsageCount', 'aiUsageMonth']);
      allow update: if isOwner(userId) && !touchesServerManagedFields();
      allow delete: if isOwner(userId);

      match /schedules/{scheduleId} {
        allow read, write: if isOwner(userId);
      }

      match /todos/{todoId} {
        allow read, write: if isOwner(userId);
      }

      match /scripts/{scriptId} {
        allow read, write: if isOwner(userId);
      }

      match /practiceLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
