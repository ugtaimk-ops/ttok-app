# Server-only settings. Put real values in a private .env file or Render env vars.
# Never prefix server secrets with VITE_ or commit the private .env file.
AI_PROVIDER=gemini
GEMINI_API_KEYS=
GEMINI_API_KEY=
NEIS_API_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
DASHBOARD_ADMIN_UIDS=

# Optional PostgreSQL pilot; the current app still uses Firestore.
DATABASE_URL=

# Public app build configuration, set in CI when building APK/AAB.
APP_URL=https://ttok-backend.onrender.com
REVENUECAT_API_KEY_ANDROID=
REVENUECAT_API_KEY_IOS=

